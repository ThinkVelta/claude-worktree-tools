root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Two trailing spaces are a hard line break in markdown.
[*.md]
trim_trailing_whitespace = false

# make requires literal tabs in recipe lines; spaces there are a syntax error.
[Makefile]
indent_style = tab
