# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?

# Node
node_modules/
npm-debug.log*
# `npm pack` drops a tarball in the repo root (see README, "Publishing").
*.tgz

# dotenv — ignore all .env variants except the example template
.env*
!.env.example

# Editors
# .vscode/ is deliberately NOT ignored: settings.json and extensions.json are
# shared editor config and are committed. Same for .editorconfig.
.idea/

# Test artifacts — test.sh writes generated repos here (`make test` -> tmp/test-make)
tmp/

# Claude Code — machine-local state only. Shared config IS committed:
# .claude/settings.json, hooks/, rules/, skills/, agents/, and README.md.
.claude/settings.local.json
.claude/agent-memory/
.claude/*.lock
# Must stay slash-less: bin/init.js matches this line EXACTLY
# (`line.trim() === ".claude/worktrees"`), so a trailing slash would make the
# installer append a duplicate every time this repo is used on itself.
.claude/worktrees
